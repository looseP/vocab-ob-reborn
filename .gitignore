# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Drizzle generated artifacts
# drizzle-release/ is the single canonical migration history (tracked).
# The legacy drizzle/ directory is superseded and should not be re-created.
drizzle/

# Local agent analysis artifacts (never commit to product PRs)
.codebase-memory/
.learnings/
docs/superpowers/plans/
docs/screenshots/
vite.review.config.ts

# Test output
coverage/
# coverage 报告的手工备份（2026-09-30 清理过一个 21MB 的）。
# coverage/ 已被上面的规则忽略，但 `coverage_bak*` 这类带后缀的备份不匹配，
# 曾以未跟踪文件的身份长期躺在仓库里，有被误提交的风险。
coverage_bak*/
playwright-report/
test-results/
test-results-*/
sbom-*.cdx.json
release-manifest.json
tests/scripts/.alerting-drill-test-*.lock*

# Environment files
.env
.env.*
!.env.example
!.env.single-host.example
!.env.cloudflare-tunnel.example
!.env.rls-acceptance.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Temporary
.tmp/
tmp/
temp/
backups/
# 开发栈的备份目录（compose.dev.yaml 里 BACKUP_HOST_DIR 的默认值）。
# 注意：项目名能隔离容器与数据卷，但**隔离不了宿主相对路径** —— 不单独忽略的话，
# 开发栈的备份会和自用栈的 ./backups 混在一起。
.dev/

# 一次性本地脚本与中间产物（2026-09-30 清理时补规则）。
# `scripts/tmp-*` 此前不在忽略范围内：2025 考研的一次性导入管线
# （PDF 抽取 → 解析 → seed json → 入库脚本）留下的 6 个文件全部以未跟踪
# 身份躺在仓库里，其中 `tmp-local-db-setup.ps1` 还含 7 个明文数据库密码 ——
# 一次 `git add .` 就会泄露。凡是 `tmp-` 前缀的本地脚本一律不进版本库。
scripts/tmp-*
scripts/*.tmp.*

# Large binary artifacts (should not be tracked in git)
*.zip
*.tar.gz
*.tgz
